{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": [
      "node",
      "vscode",
      "react",
      "react-dom",
      "mocha",
      "@testing-library/jest-dom"
    ]
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/webview/test/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ]
}
