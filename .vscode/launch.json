{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "运行扩展",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": [
        "${workspaceFolder}/dist/extension/**/*.js",
        "${workspaceFolder}/dist/extension/**/*.cjs"
      ],
      "preLaunchTask": "开发：监听构建"
    },
    {
      "name": "运行扩展（干净配置）",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--user-data-dir=${env:HOME}/.dt-vscode-user-data",
        "--extensions-dir=${env:HOME}/.dt-vscode-extensions",
        "--disable-extensions"
      ],
      "outFiles": ["${workspaceFolder}/dist/extension/**/*.cjs"],
      "preLaunchTask": "开发：监听构建"
    },
    {
      "name": "扩展宿主测试",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--extensionTestsPath=${workspaceFolder}/dist-tests/tests/integration/suite/index.js"
      ],
      "outFiles": ["${workspaceFolder}/dist-tests/**/*.js"],
      "preLaunchTask": "构建：扩展宿主测试"
    }
  ]
}
